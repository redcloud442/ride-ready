# Matches docker-compose.yml. Copy to .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ride_ready
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-dev-password
PORT=3000

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional). OAuth client "Web application";
# authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated browser origins allowed by CORS (native apps send none; leave empty to disable)
CORS_ORIGINS=
