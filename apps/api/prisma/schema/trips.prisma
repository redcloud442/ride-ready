enum TripPurpose {
  personal
  business
}

model Trip {
  id        String      @id @default(uuid())
  vehicleId String
  vehicle   Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startedAt DateTime
  endedAt   DateTime?
  gpsKm     Decimal? // kept separate from odometer readings; discrepancies get flagged, never overwritten
  route     Json? // encoded polyline / points; move to PostGIS if geo queries are needed
  purpose   TripPurpose @default(personal)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?

  @@index([vehicleId, startedAt])
}
